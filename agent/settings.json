{
  "packages": [
    "npm:pi-deepseek-search@1.0.20",
    "npm:@tintinweb/pi-subagents",
    {
      "source": "npm:pi-claude-code-ui",
      "extensions": []
    },
    "npm:pi-live-throughput",
    "npm:pi-mcp-adapter",
    "npm:better-claude-code-ui@0.1.9",
    "npm:pi-statusline",
    "npm:pi-openai-toolkit",
    "npm:@fadouse/pi-math@0.2.0",
    "npm:@vanillagreen/pi-session-manager@2.0.4"
  ],
  "lastChangelogVersion": "1.0.4",
  "theme": "claude-code-light-hc/claude-code-dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "high",
    "openai-codex/gpt-6-astra": "medium",
    "openai-codex/gpt-6-sol": "xhigh"
  },
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": true
  },
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "collapseChangelog": true,
  "editorPaddingX": 1,
  "autocompleteMaxVisible": 7,
  "compaction": {
    "enabled": true,
    "reserveTokens": 1000,
    "keepRecentTokens": 500,
    "modelOverrides": {
      "openai-codex/gpt-6-sol": { "reserveTokens": 27000 },
      "openai-codex/gpt-6.1-sol": { "reserveTokens": 27000 },
      "openai-codex/gpt-6-astra": { "reserveTokens": 27000 }
    }
  },
  "enabledModels": [
    "deepseek/deepseek-flash",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol"
  ],
  "skills": [
    "/Users/billy/.agents/skills"
  ],
  "tuiMode": "fullscreen",
  "quietStartup": true,
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 /Users/billy/.local/share/claude-codex-statusline/statusline.py --no-quota",
    "placement": "footer",
    "timeoutMs": 5000
  },
  "extensions": [
    "-builtin:mcp"
  ]
}
