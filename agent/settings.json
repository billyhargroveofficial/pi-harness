{
  "packages": [
    "npm:pi-deepseek-search@1.0.20",
    "npm:@tintinweb/pi-subagents@0.19.0",
    {
      "source": "npm:pi-claude-code-ui",
      "extensions": []
    },
    "npm:pi-live-throughput",
    "npm:pi-mcp-adapter",
    "npm:better-claude-code-ui@0.1.8",
    "npm:pi-statusline"
  ],
  "lastChangelogVersion": "0.86.0",
  "theme": "claude-code-light-hc/claude-code-dark",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": true
  },
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "collapseChangelog": true,
  "editorPaddingX": 1,
  "autocompleteMaxVisible": 7,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "enabledModels": [
    "deepseek/deepseek-flash",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-6-astra"
  ],
  "skills": [
    "/Users/billy/.agents/skills"
  ],
  "tuiMode": "fullscreen",
  "quietStartup": true,
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 /Users/billy/.local/share/claude-codex-statusline/statusline.py",
    "placement": "footer",
    "timeoutMs": 5000
  }
}
