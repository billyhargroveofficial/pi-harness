@@ -0,0 +1,37 @@
+import type { AgentSession } from "@earendil-works/pi-coding-agent";
+
+/** Names/counts only: never copy tool arguments, results, or secrets into progress. */
+export interface WorkflowToolProgress {
+  toolCalls: number;
+  toolActivity: string;
+}
+
+/** One subscription per invocation, including resume; the caller owns teardown. */
+export function observeWorkflowTools(
+  session: Pick<AgentSession, "subscribe">,
+  initialCount: number,
+  report?: (info: WorkflowToolProgress) => void,
+): () => void {
+  if (!report) return () => {};
+  let completed = initialCount;
+  const active = new Map<string, string>();
+  const recent: string[] = [];
+  const publish = () => {
+    const lines: string[] = [];
+    if (active.size) lines.push(`Running: ${[...active.values()].join(", ")}`);
+    if (recent.length) lines.push(`Recent: ${recent.join(" → ")}`);
+    report({ toolCalls: completed, toolActivity: lines.join("\n") });
+  };
+  return session.subscribe(event => {
+    if (event.type === "tool_execution_start") {
+      active.set(event.toolCallId, event.toolName);
+      publish();
+    } else if (event.type === "tool_execution_end") {
+      active.delete(event.toolCallId);
+      completed++;
+      recent.push(event.toolName);
+      if (recent.length > 6) recent.shift();
+      publish();
+    }
+  });
+}
